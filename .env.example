# --- Google auth (service account) ---
# Either point at a JSON key file:
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json
# ...or supply the two fields inline (used if the file path is unset):
# GOOGLE_SERVICE_ACCOUNT_EMAIL=my-bot@my-project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# The spreadsheet that holds all tabs (Config, Input URLs, Recommendations, ...)
SPREADSHEET_ID=your-spreadsheet-id

# Optional: overrides the "GSC property" value in the Config tab
# GSC_PROPERTY=sc-domain:example.co.uk

# Optional LLM adapter (leave unset to run fully heuristic)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-opus-4-8
